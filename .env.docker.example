# Asset Pulse — Docker environment template.
#
# Copy this file to `.env` in the repo root before running:
#   cp .env.docker.example .env        (macOS / Linux)
#   copy .env.docker.example .env       (Windows cmd)
#
# `.env` is git-ignored — never commit real secrets.

# ---- PostgreSQL (runs inside the `db` container) ----------------------------
POSTGRES_DB=assetpulse
POSTGRES_USER=assetpulse_user
# Replace with a strong password before exposing the stack outside localhost.
POSTGRES_PASSWORD=changeme

# ---- Backend (FastAPI) ------------------------------------------------------
# Comma-separated origins allowed to call the API.
# Development (local Docker):
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Production — replace with your actual domain:
# CORS_ORIGINS=https://yourdomain.com

# ---- Auth / JWT -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — any value works locally but MUST be changed before VPS deploy.
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-before-production

# Token lifetime in minutes (default 480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Default admin account (created on first boot if no users exist) --------
# Change these before deploying — they are the credentials for the initial admin.
ADMIN_EMAIL=admin@assetpulse.local
ADMIN_PASSWORD=AssetPulse2025!

# ---- Application environment ------------------------------------------------
# "production" disables OpenAPI /docs endpoint and enables stricter behaviour.
# "development" (default) keeps /docs accessible.
APP_ENV=development
