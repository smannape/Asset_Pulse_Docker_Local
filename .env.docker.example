# Asset Pulse — Docker Desktop environment template.
#
# Copy this file to `.env` in the repo root before running `docker compose up`:
#   cp .env.docker.example .env        (macOS / Linux)
#   copy .env.docker.example .env       (Windows cmd)
#
# `.env` is git-ignored — never commit real secrets.
# These values are read by docker-compose.yml at startup.

# ---- PostgreSQL (runs inside the `db` container) ----------------------------
POSTGRES_DB=assetpulse
POSTGRES_USER=assetpulse_user
# Replace with a strong password before exposing the stack outside localhost.
POSTGRES_PASSWORD=changeme

# ---- Backend (FastAPI) ------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
# 8080 = the Nginx-served frontend (default in compose).
# 5173 = the Vite dev server, in case you run the frontend outside Docker.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
