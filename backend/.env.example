# Backend env vars.
# Production: point at Neon.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.aws.neon.tech/dbname?sslmode=require

# CORS (comma-separated). Use the deployed Netlify origin in production.
CORS_ORIGINS=*

# Optional: override the local SQLite fallback location (default /tmp/capex_opex_demo.db)
# LOCAL_SQLITE_PATH=/tmp/capex_opex_demo.db
