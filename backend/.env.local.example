# ---------------------------------------------------------------------------
# Asset Pulse — local development environment (PostgreSQL 17 on localhost:5433)
#
# 1. Copy this file:        cp backend/.env.local.example backend/.env
# 2. Replace placeholders with the database, user, and password you created
#    in PostgreSQL 17 (see docs/local-deployment-postgresql17.pplx.md).
# 3. NEVER commit your real .env file. The .gitignore in this repo excludes
#    .env files automatically.
# ---------------------------------------------------------------------------

# PostgreSQL 17 running locally on port 5433.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace YOUR_DB_USER, YOUR_DB_PASSWORD, and asset_pulse with your own values.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5433/asset_pulse

# Allowed CORS origins for the FastAPI backend.
# For local development, the Vite dev server runs on http://localhost:5173.
# Comma-separate multiple origins or use * for "any" (development only).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: override the SQLite fallback path.
# Only relevant if DATABASE_URL is unset; with a valid DATABASE_URL above,
# the app uses PostgreSQL and ignores this value.
# LOCAL_SQLITE_PATH=/tmp/capex_opex_demo.db

# Optional: override the FastAPI port (default 8000).
# PORT=8000
